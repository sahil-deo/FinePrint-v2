# Google ADK / Gemini API Keys
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=your_api_key_here

# Gemini model to use (change if a model is overloaded or you want a different one)
# Options: gemini-2.0-flash, gemini-2.5-flash-preview-05-20, gemini-2.5-pro-preview-06-05, etc.
GEMINI_MODEL=gemini-2.0-flash
